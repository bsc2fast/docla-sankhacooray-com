{
  "name": "Doctor Lanka — faster eChannelling",
  "short_name": "Doctor Lanka",
  "description": "A free Chrome extension that puts a fast weekly calendar over Sri Lanka's eChannelling. Compare doctors, hospitals and times at a glance, then check out on the official site.",
  "start_url": "/doctor-lanka-web/",
  "scope": "/doctor-lanka-web/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#0b1020",
  "background_color": "#0b1020",
  "lang": "en",
  "categories": ["health", "medical", "productivity"],
  "icons": [
    { "src": "assets/logo.svg",         "sizes": "any",     "type": "image/svg+xml" },
    { "src": "assets/icon-192.png",     "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-512.png",     "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
